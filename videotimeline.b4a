
#Region  Project Attributes 
	#ApplicationLabel: Video Timeline 
	#VersionCode: 1
	#VersionName: 
	'SupportedOrientations possible values: unspecified, landscape or portrait.
	#SupportedOrientations: unspecified
	#CanInstallToExternalStorage: False
	
#End Region
#Region  Activity Attributes 
	#FullScreen: False
	#IncludeTitle: True
#End Region

Sub Process_Globals
	'These global variables will be declared once when the application starts.
	'These variables can be accessed from all modules.
	Private xui As XUI
	Private mmetadata As MediaMetadata
	
	Private hscrollView As JavaObject
	Private LinearLayout1 As JavaObject
	Private ThumbnailPositions As List  ' Store frame positions for each thumbnail
	Private CurrentThumbnailIndex As Int = -1
	Private IsPlaying As Boolean = False
	Private ThumbnailWidth As Int = 80dip
	Private ThumbnailHeight As Int = 80dip
	Private TimerSync As Timer
	Private TotalFrames As Int
	Private player1 As SimpleExoPlayer
	Private mediaFile As String="daynightsong2.mp4"
	
End Sub

Sub Globals
	
	Private imgView As ImageView
	Private thumb As ImageView
	Private exoPlayer As SimpleExoPlayerView
	Private btnPlay As Button
	
	 
End Sub

Sub Activity_Create(FirstTime As Boolean)
	Activity.LoadLayout("Layout")

		player1.Initialize("player")
		exoPlayer.Player=player1
		player1.Pause
		player1.Prepare(player1.CreateFileSource(File.DirAssets,mediaFile))

	
	imgView.Initialize("")
	mmetadata.Initialize
	If Not(File.Exists(File.DirInternal,mediaFile)) Then
		File.Copy(File.DirAssets,mediaFile,File.DirInternal,mediaFile)
	End If
	mmetadata.ProcessMediaFile(File.DirInternal,mediaFile)
	hscrollView =InflateLayout("video_timeline", Activity) ' Note: No .xml extension
	hscrollView.RunMethod("setSmoothScrollingEnabled", Array(True))
	Activity.AddView(hscrollView, 0%x, 60%y, 100%x, 90%y)
	LinearLayout1=hscrollView.RunMethod("findViewById",Array(GetViewResourceId("linear_layout")))
		
	ThumbnailPositions.Initialize
	LoadThumbnailsWithPositions
    
	
	TimerSync.Initialize("TimerSync", 100)  ' Update every 100ms
	TimerSync.Enabled = False
    
	
	
	btnPlay.Initialize("btnPlay")
	btnPlay.Text = "Play"
	Activity.AddView(btnPlay, 50%x - 40dip, 100%y - 100dip, 80dip, 40dip)
End Sub
Sub LoadThumbnailsWithPositions
	LinearLayout1.As(Panel).RemoveAllViews
	ThumbnailPositions.Clear

	Dim VideoDurationSeconds As Int = mmetadata.GetDurationSeconds
	If VideoDurationSeconds <= 0 Then
		Log("Could not determine video duration")
		Return
	End If

	Dim MaxThumbnails As Int = 50
	Dim StepSize As Int = Ceil(VideoDurationSeconds / MaxThumbnails)
	If StepSize < 1 Then StepSize = 1

	Dim Spacing As Int = 5dip
	Dim second As Int = 0

	Do While second < VideoDurationSeconds
		ThumbnailPositions.Add(second)  ' stored in seconds, consistently

		Dim bmp As Bitmap = mmetadata.getFrameBitmapSampled(second, ThumbnailWidth, ThumbnailHeight)
		If bmp.IsInitialized Then
			Dim thumb As ImageView
			thumb.Initialize("thumb")
			thumb.Bitmap = bmp
			thumb.Tag = second

			Dim pnl As Panel
			pnl.Initialize("")
			pnl.Tag = second
			pnl.SetLayout(0, 0, ThumbnailWidth, ThumbnailHeight)
			pnl.AddView(thumb, 0, 0, ThumbnailWidth, ThumbnailHeight)

			Dim lp As JavaObject
			lp.InitializeNewInstance("android.widget.LinearLayout$LayoutParams", _
				Array(ThumbnailWidth, ThumbnailHeight))
			lp.RunMethod("setMargins", Array(Spacing, 5dip, Spacing, 5dip))

			Dim linearJO As JavaObject = LinearLayout1
			linearJO.RunMethod("addView", Array(pnl, lp))
		End If

		second = second + StepSize
	Loop

	
End Sub

Sub TimerSync_Tick
	If IsPlaying And player1.IsPlaying Then
		Dim CurrentPosition As Int = player1.Position  ' in milliseconds
		Dim CurrentSecond As Int = CurrentPosition / 1000
        
		Dim targetIndex As Int = FindClosestThumbnail(CurrentSecond)
        
		If targetIndex <> CurrentThumbnailIndex Then
			CurrentThumbnailIndex = targetIndex
			HighlightThumbnail(targetIndex)
			ScrollToThumbnail(targetIndex)
		End If
        
		UpdateMainImage(CurrentSecond)
	End If
End Sub
Sub FindClosestThumbnail(second As Int) As Int
	Dim closestIndex As Int = 0
	Dim minDiff As Int = 999999

	For i = 0 To ThumbnailPositions.Size - 1
		Dim pos As Int = ThumbnailPositions.Get(i)
		Dim diff As Int = Abs(pos - second)   ' both already in seconds
		If diff < minDiff Then
			minDiff = diff
			closestIndex = i
		End If
	Next

	Return closestIndex
End Sub
Sub ScrollToThumbnail(index As Int)
	If index >= 0 Then
		
		Dim childCount As Int = LinearLayout1.RunMethod("getChildCount", Null)
        
		If index < childCount Then
			Dim targetView As JavaObject = LinearLayout1.RunMethod("getChildAt", Array(index))
            If targetView <> Null Then
				Dim targetX As Int = targetView.RunMethod("getLeft", Null)
            	Dim scrollWidth As Int = hscrollView.RunMethod("getWidth", Null)
            	Dim scrollX As Int = targetX - (scrollWidth / 2) + (ThumbnailWidth / 2)
				If scrollX < 0 Then scrollX = 0
                	hscrollView.RunMethod("smoothScrollTo", Array(scrollX, 0))
				
			End If
		End If
	End If
End Sub

Sub HighlightThumbnail(index As Int)
	Dim count As Int = LinearLayout1.RunMethod("getChildCount", Null)
    
		For i = 0 To count - 1
		Dim child As JavaObject = LinearLayout1.RunMethod("getChildAt", Array(i))
		If child <> Null Then
			' Remove background/border
			child.RunMethod("setBackground", Array(Null))
		End If
	Next
  
	If index >= 0 And index < count Then
		Log(index)
		Dim child As JavaObject = LinearLayout1.RunMethod("getChildAt", Array(index))
		If child <> Null Then
			Dim border As JavaObject
			border.InitializeNewInstance("android.graphics.drawable.GradientDrawable", Null)
			border.RunMethod("setStroke", Array(3dip, Colors.Red))
			border.RunMethod("setColor", Array(Colors.Transparent))
			child.RunMethod("setBackground", Array(border))
		End If
	End If
End Sub
Sub UpdateMainImage(second As Int)
	Try
		Dim bmp As Bitmap = mmetadata.getFrameBitmapSampled(second, imgView.Width, imgView.Height)
		If bmp.IsInitialized Then
			imgView.Bitmap = bmp
		End If
	Catch
		Log(LastException.Message)
	End Try
End Sub


Sub MediaPlayer_Ready
	Log("MediaPlayer ready")
End Sub

Sub MediaPlayer_Complete
	IsPlaying = False
	TimerSync.Enabled = False
	Log("Playback complete")
End Sub


Sub btnPlay_Click
	If IsPlaying Then
		
		player1.Pause
		IsPlaying = False
		TimerSync.Enabled = False
		btnPlay.Text = "Play"
	Else
		
		player1.Play
		IsPlaying = True
		TimerSync.Enabled = True
		btnPlay.Text = "Pause"
	End If
End Sub

Sub thumb_Click
	Dim thumb As ImageView = Sender
	Dim second As Int = thumb.Tag   ' Tag is now already in seconds

	player1.Position = second * 1000
	UpdateMainImage(second)

	Dim index As Int = FindClosestThumbnail(second)
	HighlightThumbnail(index)
	ScrollToThumbnail(index)
End Sub
Sub LoadThumbnails
	LinearLayout1.as(Panel).RemoveAllViews
    
	Dim TotalFrames As Int = 100
	Dim ThumbnailWidth As Int = 80dip
	Dim ThumbnailHeight As Int = 80dip
	Dim Spacing As Int = 1dip
	Dim duration As Long
	Dim duration As Long = mmetadata.SafeParseInt(mmetadata.GetDuration, 0)
	Dim fact As Long=10
	Dim newPosition As Long
	
	For i = 0 To TotalFrames - 1 'Step 5
		newPosition= duration * i * fact
		Dim bmp As Bitmap = mmetadata.getFrameBitmapScaled(newPosition, ThumbnailWidth, ThumbnailHeight)
      	If bmp.IsInitialized Then
			
			thumb.Initialize("thumb")
			
			thumb.Bitmap = bmp
			thumb.Tag = i
         
			Dim lp As JavaObject
			lp.InitializeNewInstance("android.widget.LinearLayout$LayoutParams", _
                Array(ThumbnailWidth, ThumbnailHeight))
            
			Dim marginLeft As Int = Spacing
			Dim marginTop As Int = 5dip
			Dim marginRight As Int = Spacing
			Dim marginBottom As Int = 5dip
			lp.RunMethod("setMargins", Array(marginLeft, marginTop, marginRight, marginBottom))
            
			Dim linearJO As JavaObject = LinearLayout1
			linearJO.RunMethod("addView", Array(thumb, lp))
		End If
	Next
End Sub

Sub InflateLayout(LayoutName As String, Parent As Panel) As View
	Dim context As JavaObject
	context.InitializeContext

	Dim resources As JavaObject
	resources = context.RunMethod("getResources", Null)
    
	Dim inflater As JavaObject
	inflater = context.RunMethod("getSystemService", Array("layout_inflater"))

	Dim resName As String = LayoutName.Replace(".xml", "") ' Remove .xml extension
	Dim resID As Int = resources.RunMethod("getIdentifier", Array(resName, "layout",Application.PackageName))
    
	If resID = 0 Then
		Log("Error: Layout file not found in resources - " & LayoutName)
		Return Null
	End If

	Dim view As JavaObject
	view = inflater.RunMethod("inflate", Array(resID, Parent, False))

	Return view
End Sub

Sub GetViewResourceId(ViewName As String) As Int
	Dim context As JavaObject
	context.InitializeContext
	Dim resources As JavaObject = context.RunMethod("getResources", Null)
	Dim pkg As String = context.RunMethod("getPackageName", Null)
	Return resources.RunMethod("getIdentifier", Array(ViewName, "id", pkg))
End Sub
Sub getDrawable(drawableName As String) As JavaObject
	Dim resId As Int = GetResourceId(drawableName, "drawable")
    
	Dim resources As JavaObject
	resources.InitializeContext.RunMethodJO("getResources", Null)
	Dim drawable As JavaObject = resources.RunMethod("getDrawable", Array(resId))
	Return drawable
End Sub

Sub GetResourceId(name As String, resType As String) As Int
	Dim jo As JavaObject
	jo.InitializeContext
	Return jo.RunMethodJO("getResources", Null).RunMethod("getIdentifier", _
        Array(name, resType, Application.PackageName))
End Sub

Sub Activity_Resume

End Sub

Sub Activity_Pause (UserClosed As Boolean)

End Sub
